# The game server as a systemd service (docs/DEPLOY.md): started at boot, restarted if it stops.
# deploy/install.sh copies this to /etc/systemd/system/ with GC_DOMAIN replaced.
# Its log: journalctl -u global-cataclysm -f   (journald rotates it)

[Unit]
Description=Global Cataclysm: 1972 game server
After=network-online.target
Wants=network-online.target

[Service]
User=gc
Group=gc
WorkingDirectory=/opt/global-cataclysm
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/global-cataclysm/.venv/bin/python -m server.app --host 127.0.0.1 --port 8765 --behind-proxy --download-url https://GC_DOMAIN/
Restart=on-failure
RestartSec=5
# (games are saved as they go: a restart picks them up where they were)
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
